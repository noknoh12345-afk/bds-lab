# the autopilot appends to these from several places (CI, this machine): keep both sides, never a conflict
auto/ledger.jsonl merge=union
auto/LESSONS.md merge=union
# Scripts keep the line endings their interpreter needs, whatever git's autocrlf is on the machine that clones
# (a .sh checked out with CRLF on Windows does not run in WSL or Git Bash; cmd and PowerShell take CRLF).
*.sh       text eol=lf
*.command  text eol=lf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
