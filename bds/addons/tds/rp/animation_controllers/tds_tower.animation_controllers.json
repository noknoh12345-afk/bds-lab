{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.tds_tower.level": {
   "initial_state": "default",
   "states": {
    "default": {
     "transitions": [
      {
       "pop": "q.property('tds:lvl') != v.lvl"
      }
     ]
    },
    "pop": {
     "animations": [
      "levelup"
     ],
     "on_entry": [
      "v.lvl = q.property('tds:lvl');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished"
      }
     ]
    }
   }
  }
 }
}
