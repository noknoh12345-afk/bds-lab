   "scripts": {
    "scale": "0.36 * q.property('tds:size') * (1 - v.fade)",
    "initialize": [
     "v.lvl = 0; v.yaw = 0; v.clock = math.random(0, 10); v.dying = 0; v.fade = 0;"
    ],
    "pre_animation": [
     "v.st = q.property('tds:st');",
     "v.clock = v.clock + (v.st == 2 ? 0 : q.delta_time);",
     "v.dy = math.mod(math.mod(q.property('tds:yaw') - q.body_y_rotation - v.yaw, 360) + 540, 360) - 180;",
     "v.yaw = (v.st == 1 || v.st == 2) ? v.yaw : v.yaw + math.clamp(v.dy, -q.delta_time * 540, q.delta_time * 540);",
     "v.dying = v.st == 3 ? v.dying + q.delta_time : 0;",
     "v.fade = math.clamp(v.dying / 0.25, 0, 1);"
    ],
    "animate": [
     "aim",
     {
      "aim_root": "(q.property('tds:skin') >= 0 && q.property('tds:skin') < 63)"
     },
     {
      "stand_root": "(q.property('tds:skin') >= 0 && q.property('tds:skin') < 63)"
     },
     {
      "pose_hold": "(q.property('tds:skin') >= 0 && q.property('tds:skin') < 38)"
     },
     {
      "pose_bow": "q.property('tds:skin') == 38"
     },
     {
      "pose_type": "q.property('tds:skin') == 39"
     },
     {
      "pose_dual": "(q.property('tds:skin') >= 40 && q.property('tds:skin') < 42)"
     },
     {
      "pose_ready": "(q.property('tds:skin') >= 42 && q.property('tds:skin') < 48)"
     },
     {
      "pose_ready2": "(q.property('tds:skin') >= 48 && q.property('tds:skin') < 50)"
     },
     {
      "pose_cast": "(q.property('tds:skin') >= 50 && q.property('tds:skin') < 57)"
     },
     {
      "pose_throw": "(q.property('tds:skin') >= 57 && q.property('tds:skin') < 62)"
     },
     "idle",
     "place",
     "level",
     {
      "smoke": "q.property('tds:skin') == 63"
     },
     {
      "dizzy": "v.st == 1"
     }
    ]
   },
   "animations": {
    "aim": "animation.tds_tower.aim",
