{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "tds:unit",
   "materials": {
    "default": "entity_emissive_alpha_one_sided",
    "blend": "entity_alphablend"
   },
   "textures": {
    "t0": "textures/entity/tds/unit_jeep",
    "t1": "textures/entity/tds/unit_soldier",
    "t2": "textures/entity/tds/unit_sentry",
    "t3": "textures/entity/tds/unit_soldier_skeleton",
    "t4": "textures/entity/tds/unit_ice",
    "t5": "textures/entity/tds/unit_soldier",
    "t6": "textures/entity/tds/unit_soldier",
    "t7": "textures/entity/tds/unit_soldier"
   },
   "geometry": {
    "g0": "geometry.tds.unit_jeep",
    "g1": "geometry.tds.unit_soldier",
    "g2": "geometry.tds.unit_sentry",
    "g3": "geometry.tds.unit_soldier",
    "g4": "geometry.tds.unit_ice",
    "g5": "geometry.tds.unit_soldier",
    "g6": "geometry.tds.unit_soldier",
    "g7": "geometry.tds.unit_soldier"
   },
   "scripts": {
    "scale": "0.4 * q.property('tds:size')",
    "animate": [
     {
      "walk": "q.property('tds:skin') == 1 || q.property('tds:skin') == 3 || q.property('tds:skin') > 4"
     },
     {
      "wheels": "q.property('tds:skin') == 0"
     },
     {
      "sweep": "q.property('tds:skin') == 2"
     },
     {
      "spin": "q.property('tds:skin') == 4"
     }
    ]
   },
   "render_controllers": [
    "controller.render.tds_unit"
   ],
   "animations": {
    "walk": "animation.tds_unit.walk",
    "wheels": "animation.tds_unit.wheels",
    "sweep": "animation.tds_unit.sweep",
    "spin": "animation.tds_unit.spin"
   }
  }
 }
}
