   "scripts": {
    "initialize": [
     "v.walk = math.random(0, 360); v.move = 0; v.clock = math.random(0, 10); v.dying = 0; v.fall = 0; v.drop = 0; v.fade = 0;"
    ],
    "pre_animation": [
     "v.sz = math.max(0.3, q.property('tds:size'));",
     "v.st = q.property('tds:st');",
     "v.pace = (v.st == 1 || v.st == 2) ? 0 : q.property('tds:pace') * 0.1;",
     "v.clock = v.clock + (v.st == 2 ? 0 : q.delta_time);",
     "v.walk = math.mod(v.walk + q.delta_time * v.pace * 400.0 * (q.property('tds:skin') < 12 ? 1.22 : (q.property('tds:skin') < 17 ? 1.22 : (q.property('tds:skin') < 21 ? 1.22 : (q.property('tds:skin') < 26 ? 1.22 : (q.property('tds:skin') < 30 ? 1.3 : (q.property('tds:skin') < 31 ? 0.87 : (q.property('tds:skin') < 33 ? 1.7 : (q.property('tds:skin') < 34 ? 1.17 : (q.property('tds:skin') < 43 ? 1.35 : (q.property('tds:skin') < 44 ? 1.0 : (q.property('tds:skin') < 49 ? 1.0 : (q.property('tds:skin') < 54 ? 1.0 : (q.property('tds:skin') < 57 ? 1.0 : (q.property('tds:skin') < 62 ? 1.6 : (q.property('tds:skin') < 63 ? 2.0 : (q.property('tds:skin') < 64 ? 1.27 : 1)))))))))))))))) / v.sz, 3600);",
     "v.move = math.lerp(v.move, (v.pace > 0.05 && v.st < 3) ? 1 : 0, math.min(1, q.delta_time * 8));",
     "v.dying = v.st >= 3 ? v.dying + q.delta_time : 0;",
     "v.fall = math.min(1, math.pow(v.dying / 0.42, 2)) - ((v.dying > 0.42 && v.dying < 0.62) ? math.sin((v.dying - 0.42) * 900) * 0.06 : 0);",
     "v.drop = math.min(1, math.pow(v.dying / 0.55, 2));",
     "v.fade = v.st == 4 ? math.clamp(v.dying / 0.3, 0, 1) : (v.st >= 3 ? math.clamp((v.dying - 0.6) / 0.3, 0, 1) : 0);",
     "v.grow = q.life_time < 0.4 ? math.sin(q.life_time * 300) / 0.866 : 1;"
    ],
    "scale": "0.28 * q.property('tds:size') * v.grow * (1 - v.fade)",
    "animate": [
     {
      "patrol": "q.property('tds:skin') >= 0 && q.property('tds:skin') < 12"
     },
     {
      "pistol": "q.property('tds:skin') >= 12 && q.property('tds:skin') < 17"
     },
     {
      "carry": "q.property('tds:skin') >= 17 && q.property('tds:skin') < 21"
     },
     {
      "brawl": "q.property('tds:skin') >= 21 && q.property('tds:skin') < 26"
     },
     {
      "march": "q.property('tds:skin') >= 26 && q.property('tds:skin') < 30"
     },
     {
      "run": "q.property('tds:skin') >= 30 && q.property('tds:skin') < 31"
     },
     {
      "stomp": "q.property('tds:skin') >= 31 && q.property('tds:skin') < 33"
     },
     {
      "ride": "q.property('tds:skin') >= 33 && q.property('tds:skin') < 34"
     },
     {
      "drive": "q.property('tds:skin') >= 34 && q.property('tds:skin') < 43"
     },
     {
      "fly": "q.property('tds:skin') >= 43 && q.property('tds:skin') < 44"
     },
     {
      "stride": "q.property('tds:skin') >= 44 && q.property('tds:skin') < 49"
     },
     {
      "sentry": "q.property('tds:skin') >= 49 && q.property('tds:skin') < 54"
     },
     {
      "sway": "q.property('tds:skin') >= 54 && q.property('tds:skin') < 57"
     },
     {
      "waddle": "q.property('tds:skin') >= 57 && q.property('tds:skin') < 62"
     },
     {
      "scuttle": "q.property('tds:skin') >= 62 && q.property('tds:skin') < 63"
     },
     {
      "golem": "q.property('tds:skin') >= 63 && q.property('tds:skin') < 64"
     },
     "fx",
     {
      "steady_r_march": "(q.property('tds:skin') >= 26 && q.property('tds:skin') < 30)"
     },
     {
      "steady_r_stomp": "(q.property('tds:skin') >= 31 && q.property('tds:skin') < 33)"
     },
     {
      "die_root_0p0": "v.st == 3 && ((q.property('tds:skin') >= 0 && q.property('tds:skin') < 26) || q.property('tds:skin') == 30 || (q.property('tds:skin') >= 33 && q.property('tds:skin') < 64))"
     },
     {
      "fall_root_0p0": "v.st == 5 && ((q.property('tds:skin') >= 0 && q.property('tds:skin') < 26) || q.property('tds:skin') == 30 || (q.property('tds:skin') >= 33 && q.property('tds:skin') < 64))"
     },
     {
      "leave_root_0p0": "v.st == 4 && ((q.property('tds:skin') >= 0 && q.property('tds:skin') < 26) || q.property('tds:skin') == 30 || (q.property('tds:skin') >= 33 && q.property('tds:skin') < 64))"
     },
     {
      "die_waist_12p0": "v.st == 3 && ((q.property('tds:skin') >= 26 && q.property('tds:skin') < 30) || (q.property('tds:skin') >= 31 && q.property('tds:skin') < 33))"
     },
     {
      "fall_waist_12p0": "v.st == 5 && ((q.property('tds:skin') >= 26 && q.property('tds:skin') < 30) || (q.property('tds:skin') >= 31 && q.property('tds:skin') < 33))"
     },
     {
      "leave_waist_12p0": "v.st == 4 && ((q.property('tds:skin') >= 26 && q.property('tds:skin') < 30) || (q.property('tds:skin') >= 31 && q.property('tds:skin') < 33))"
     },
     {
      "dizzy": "v.st == 1"
     }
    ]
   },
