   "scripts": {
    "scale": "0.26 * q.property('tds:size')",
    "animate": [
     {
      "walk": "q.property('tds:skin') >= 0 && q.property('tds:skin') < 12"
     },
     {
      "march": "q.property('tds:skin') >= 12 && q.property('tds:skin') < 33"
     },
     {
      "run": "q.property('tds:skin') >= 33 && q.property('tds:skin') < 54"
     },
     {
      "stomp": "q.property('tds:skin') >= 54 && q.property('tds:skin') < 88"
     },
     {
      "hover": "q.property('tds:skin') >= 88 && q.property('tds:skin') < 94"
     },
     {
      "vex": "q.property('tds:skin') >= 94 && q.property('tds:skin') < 100"
     },
     {
      "phantom": "q.property('tds:skin') >= 100 && q.property('tds:skin') < 102"
     },
     {
      "golem": "q.property('tds:skin') >= 102 && q.property('tds:skin') < 117"
     },
     {
      "beast": "q.property('tds:skin') >= 117 && q.property('tds:skin') < 120"
     },
     {
      "mite": "q.property('tds:skin') >= 120 && q.property('tds:skin') < 123"
     },
     {
      "stand": "q.property('tds:skin') >= 123 && q.property('tds:skin') < 124"
     },
     {
      "blaze": "q.property('tds:skin') >= 124 && q.property('tds:skin') < 125"
     },
     {
      "hop": "q.property('tds:skin') >= 125 && q.property('tds:skin') < 137"
     },
     {
      "float": "q.property('tds:skin') >= 137 && q.property('tds:skin') < 144"
     },
     "fx"
    ]
   },
