{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "tds:enemy",
   "materials": {
    "default": "entity_alphatest",
    "blend": "entity_alphablend"
   },
   "textures": {
    "t0": "textures/entity/tds/enemy_0",
    "t1": "textures/entity/tds/enemy_1",
    "t2": "textures/entity/tds/enemy_2",
    "t3": "textures/entity/tds/enemy_3",
    "t4": "textures/entity/tds/enemy_4",
    "t5": "textures/entity/tds/enemy_5",
    "t6": "textures/entity/tds/enemy_6",
    "t7": "textures/entity/tds/enemy_7"
   },
   "geometry": {
    "default": "geometry.tds.enemy"
   },
   "scripts": {
    "scale": "0.45 * query.property('tds:size')",
    "animate": [
     "walk",
     {
      "fly": "query.property('tds:skin') == 5"
     }
    ]
   },
   "render_controllers": [
    "controller.render.tds_enemy"
   ],
   "animations": {
    "walk": "animation.tds.walk",
    "fly": "animation.tds.fly"
   }
  }
 }
}
