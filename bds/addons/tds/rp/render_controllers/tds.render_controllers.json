{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.tds_enemy": {
   "arrays": {
    "textures": {
     "Array.skins": [
      "Texture.t0",
      "Texture.t1",
      "Texture.t2",
      "Texture.t3",
      "Texture.t4",
      "Texture.t5",
      "Texture.t6",
      "Texture.t7"
     ]
    },
    "geometries": {
     "Array.geos": [
      "Geometry.g0",
      "Geometry.g1",
      "Geometry.g2",
      "Geometry.g3",
      "Geometry.g4",
      "Geometry.g5",
      "Geometry.g6",
      "Geometry.g7"
     ]
    },
    "materials": {
     "Array.mats": [
      "Material.default",
      "Material.blend"
     ]
    }
   },
   "geometry": "Array.geos[q.property('tds:skin')]",
   "materials": [
    {
     "*": "Array.mats[q.property('tds:skin') == 4 ? 1 : 0]"
    }
   ],
   "textures": [
    "Array.skins[q.property('tds:skin')]"
   ]
  },
  "controller.render.tds_tower": {
   "arrays": {
    "textures": {
     "Array.skins": [
      "Texture.t0",
      "Texture.t1",
      "Texture.t2",
      "Texture.t3",
      "Texture.t4",
      "Texture.t5",
      "Texture.t6",
      "Texture.t7"
     ]
    },
    "geometries": {
     "Array.geos": [
      "Geometry.g0",
      "Geometry.g1",
      "Geometry.g2",
      "Geometry.g3",
      "Geometry.g4",
      "Geometry.g5",
      "Geometry.g6",
      "Geometry.g7"
     ]
    },
    "materials": {
     "Array.mats": [
      "Material.default",
      "Material.blend"
     ]
    }
   },
   "geometry": "Array.geos[q.property('tds:skin')]",
   "materials": [
    {
     "*": "Array.mats[q.property('tds:skin') == 6 ? 1 : 0]"
    }
   ],
   "textures": [
    "Array.skins[q.property('tds:skin')]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "pip1": "q.property('tds:lvl') >= 1"
    },
    {
     "pip2": "q.property('tds:lvl') >= 2"
    },
    {
     "pip3": "q.property('tds:lvl') >= 3"
    },
    {
     "pip4": "q.property('tds:lvl') >= 4"
    },
    {
     "pip5": "q.property('tds:lvl') >= 5"
    },
    {
     "pip6": "q.property('tds:lvl') >= 6"
    },
    {
     "pip7": "q.property('tds:lvl') >= 7"
    }
   ]
  },
  "controller.render.tds_unit": {
   "arrays": {
    "textures": {
     "Array.skins": [
      "Texture.t0",
      "Texture.t1",
      "Texture.t2",
      "Texture.t3",
      "Texture.t4",
      "Texture.t5",
      "Texture.t6",
      "Texture.t7"
     ]
    },
    "geometries": {
     "Array.geos": [
      "Geometry.g0",
      "Geometry.g1",
      "Geometry.g2",
      "Geometry.g3",
      "Geometry.g4",
      "Geometry.g5",
      "Geometry.g6",
      "Geometry.g7"
     ]
    }
   },
   "geometry": "Array.geos[q.property('tds:skin')]",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.skins[q.property('tds:skin')]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "helmet": "q.property('tds:skin') != 3"
    }
   ]
  },
  "controller.render.tds_ghost": {
   "arrays": {
    "textures": {
     "Array.tints": [
      "Texture.bad",
      "Texture.ok"
     ]
    },
    "geometries": {
     "Array.geos": [
      "Geometry.g0",
      "Geometry.g1",
      "Geometry.g2",
      "Geometry.g3",
      "Geometry.g4",
      "Geometry.g5",
      "Geometry.g6",
      "Geometry.g7"
     ]
    }
   },
   "geometry": "Array.geos[q.property('tds:skin')]",
   "materials": [
    {
     "*": "Material.blend"
    }
   ],
   "textures": [
    "Array.tints[q.property('tds:ok') ? 1 : 0]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "pip1": false
    },
    {
     "pip2": false
    },
    {
     "pip3": false
    },
    {
     "pip4": false
    },
    {
     "pip5": false
    },
    {
     "pip6": false
    },
    {
     "pip7": false
    }
   ]
  }
 }
}
