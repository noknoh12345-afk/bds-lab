      "render_controllers": [
        {
          "controller.render.ghd_a0": "q.is_in_ui && !variable.is_paperdoll"
        },
        {
          "controller.render.ghd_a1": "q.is_in_ui && !variable.is_paperdoll"
        },
        {
          "controller.render.player.first_person_spectator": "(variable.is_first_person && query.is_spectator) && !(q.is_local_player && !q.is_in_ui && (v.ghd_hide > 0))"
        },
        {
          "controller.render.player.third_person_spectator": "(!variable.is_first_person && !variable.map_face_icon && query.is_spectator) && !(q.is_local_player && !q.is_in_ui && (v.ghd_hide > 0))"
        },
        {
          "controller.render.player.first_person": "(variable.is_first_person && !query.is_spectator) && !(q.is_local_player && !q.is_in_ui && (v.ghd_hide > 0))"
        },
        {
          "controller.render.player.third_person": "(!variable.is_first_person && !variable.map_face_icon && !query.is_spectator) && !(q.is_local_player && !q.is_in_ui && (v.ghd_hide > 0))"
        },
        {
          "controller.render.player.map": "variable.map_face_icon"
        }
      ],
      "enable_attachables": true
    }
  }
