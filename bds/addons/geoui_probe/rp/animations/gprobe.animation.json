{
  "format_version": "1.8.0",
  "animations": {
    "animation.gprobe_transform": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "geo_ui": {
          "position": [
            "v.geoui_ox+v.geoui_cx",
            "v.geoui_oy+v.geoui_cy",
            0
          ],
          "scale": "v.geoui_scale"
        }
      }
    },
    "animation.gprobe.probe": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "ctl": {
          "scale": "(v.gp_t == 1 || v.gp_t == 99) ? 1 : 0"
        },
        "clockpre": {
          "position": [
            "(v.gp_t == 2 || v.gp_t == 99) ? math.clamp(v.gp_cl, 0, 6) * 15 : 0",
