    "animation.gprobe.clockanim": {
      "loop": true,
      "animation_length": 100,
      "bones": {
        "clockanim": {
          "position": [
            "math.clamp(q.anim_time, 0, 6) * 15",
            0,
            0
          ]
        }
      }
    },
    "animation.gprobe.clocklife": {
      "loop": true,
      "animation_length": 100,
      "bones": {
        "clocklife": {
          "position": [
            "math.clamp(q.life_time, 0, 6) * 15",
            0,
            0
          ]
        }
      }
    }
  }
