    "skin_studio_glass:entity_alphablend": {
      "+states": [
        "DisableDepthWrite"
      ]
    },
    "skin_studio_mask_1:entity": {
      "+states": [
        "EnableStencilTest",
        "StencilWrite",
        "DisableColorWrite",
        "DisableDepthWrite"
      ],
      "stencilRef": 1,
      "stencilReadMask": 7,
      "stencilWriteMask": 7,
      "frontFace": {
        "stencilFunc": "Always",
        "stencilFailOp": "Keep",
        "stencilDepthFailOp": "Keep",
        "stencilPassOp": "Replace"
      },
      "backFace": {
        "stencilFunc": "Always",
        "stencilFailOp": "Keep",
        "stencilDepthFailOp": "Keep",
        "stencilPassOp": "Replace"
      }
    },
