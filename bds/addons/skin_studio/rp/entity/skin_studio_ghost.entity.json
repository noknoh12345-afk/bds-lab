      "scripts": {
        "pre_animation": [
          "v.ss_ch = q.property('skin_studio:ch'); t.ssx = q.property('skin_studio:gx') / 2; t.ssz = q.property('skin_studio:gz') / 2; t.ssc = math.cos(q.body_y_rotation); t.sss = math.sin(q.body_y_rotation); v.ss_gx = 16 * (t.ssc * t.ssx + t.sss * t.ssz); v.ss_gy = 16 * q.property('skin_studio:gy'); v.ss_gz = 16 * (t.sss * t.ssx - t.ssc * t.ssz); v.ss_gr = q.property('skin_studio:gf') * 90 - q.body_y_rotation; v.ss_swap = math.abs(t.sss) > 0.5; t.ssa = q.property('skin_studio:ax'); v.ss_rx = ((t.ssa == 2 && !v.ss_swap) || (t.ssa == 1 && v.ss_swap)) ? 90 : 0; v.ss_rz = ((t.ssa == 1 && !v.ss_swap) || (t.ssa == 2 && v.ss_swap)) ? 90 : 0;"
        ],
        "animate": [
          "ss_window"
        ]
      },
