{
  "format_version": "1.8.0",
  "animations": {
    "animation.skin_podium.refl.place": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            "variable.sp_sx * variable.sp_ru * 16 / (variable.sp_k * 0.9375) + (variable.sp_sn ?? 0) * 9 * math.sin(variable.sp_ry)",
            "variable.sp_rv * 16 / (variable.sp_k * 0.9375) + (variable.sp_sn ?? 0) * 1.25",
            0
          ],
          "rotation": [
            "(variable.sp_sn ?? 0) * 28",
            "variable.sp_ry",
            0
          ]
        }
      }
    },
    "animation.skin_podium.refl.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "variable.sp_hx ?? 0",
            "variable.sp_hy ?? 0",
            0
          ]
        }
      }
    },
    "animation.skin_podium.refl.walk": {
      "loop": true,
      "bones": {
        "leftarm": {
          "rotation": [
            "variable.sp_tc ?? 0",
            0,
            0
          ]
        },
        "rightarm": {
          "rotation": [
            "-(variable.sp_tc ?? 0)",
            0,
            0
          ]
        },
        "leftleg": {
          "rotation": [
            "(variable.sp_tc ?? 0) * -1.4",
            -0.1,
            -0.1
          ]
        },
        "rightleg": {
          "rotation": [
            "(variable.sp_tc ?? 0) * 1.4",
            0.1,
            0.1
          ]
        }
      }
    },
    "animation.skin_podium.refl.bob": {
      "loop": true,
      "bones": {
        "leftarm": {
          "rotation": [
            0,
            0,
            "-((math.cos(query.life_time * 103.2) * 2.865) + 2.865)"
          ]
        },
        "rightarm": {
          "rotation": [
            0,
            0,
            "(math.cos(query.life_time * 103.2) * 2.865) + 2.865"
          ]
        }
      }
    },
    "animation.skin_podium.refl.sneak": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            0,
            -2,
            0
          ]
        },
        "head": {
          "position": [
            0,
            -1,
            0
          ]
        },
        "leftarm": {
          "rotation": [
            -5.7,
            0,
            0
          ]
        },
        "rightarm": {
          "rotation": [
            -5.7,
            0,
            0
          ]
        },
        "leftleg": {
          "rotation": [
            -28,
            -0.1,
            -0.1
          ]
        },
        "rightleg": {
          "rotation": [
            -28,
            0.1,
            0.1
          ]
        }
      }
    }
  }
}