{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.skin_studio.mask": {
      "geometry": "Geometry.ss_mask",
      "textures": [
        "Texture.ss_mask"
      ],
      "materials": [
        {
          "*": "(v.ss_ch == 2 ? Material.ss_mask__c2 : (v.ss_ch == 3 ? Material.ss_mask__c3 : (v.ss_ch == 4 ? Material.ss_mask__c4 : Material.ss_mask__c1)))"
        }
      ]
    },
    "controller.render.skin_studio.mob_marker": {
      "geometry": "Geometry.ss_marker",
      "textures": [
        "Texture.ss_marker"
      ],
      "materials": [
        {
          "*": "(v.ss_ch == 2 ? Material.ss_marker__c2 : (v.ss_ch == 3 ? Material.ss_marker__c3 : (v.ss_ch == 4 ? Material.ss_marker__c4 : Material.ss_marker__c1)))"
        }
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "ss_mark": "(v.ss_dbg ?? 0) && (v.ss_show ?? 0)"
        },
        {
          "ss_mark_dot": "(v.ss_dbg ?? 0) && (v.ss_show ?? 0) && (v.ss_live ?? 0) && 1"
        },
        {
          "ss_mark_tri": "(v.ss_dbg ?? 0) && (v.ss_show ?? 0) && !(v.ss_live ?? 0) && 1"
        },
        {
          "ss_mark_box": "(v.ss_dbg ?? 0) && (v.ss_show ?? 0) && (v.ss_live ?? 0) && !1"
        },
        {
          "ss_mark_x": "(v.ss_dbg ?? 0) && (v.ss_show ?? 0) && !(v.ss_live ?? 0) && !1"
        }
      ]
    }
  }
}
