{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.skin_studio.gauge": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ]
    },
    "controller.render.skin_studio.gauge_cube": {
      "geometry": "Geometry.cube",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.lit"
        }
      ]
    },
    "controller.render.skin_studio.gauge_seen": {
      "geometry": "Geometry.seen",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "(v.ss_ch == 2 ? Material.seen__c2 : (v.ss_ch == 3 ? Material.seen__c3 : (v.ss_ch == 4 ? Material.seen__c4 : Material.seen__c1)))"
        }
      ]
    }
  }
}
