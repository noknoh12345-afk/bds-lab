{
 "header": [
  "# Spectral Player の測定リグ（本物のクライアントが鳴らした音を録る）: node lab.mjs app run -a spectral --device redroid",
  "#   GitHub では Actions → redroid → Run workflow（addon: spectral, mode: run）。数はジョブのログの `[spectral rig]` の行、録音そのものは",
  "#   `audio export` が Opus にして実行の成果物の public/spectral/rec/ に公開する（鍵なし: 管理パネルでサインインして聞ける・",
  "#   notify.yml が Discord に送る・tools/rig/fetch_rec.py <run> で取る）。",
  "# キュー 08（tools/exp/queue/q08_walking_talker.json）: 歩く話し手と止まった話し手（今の版、6 曲）。1.2.0 の歩く話し手（作り直し cut）を今の版で。止まった話し手と同じ run で比べる（23 回目は古い版）"
 ],
 "batch": 12,
 "setup": [
  "tp @s 0 -60 0 0 0",
  "summon armor_stand talker 0 -60 3"
 ],
 "interleave": [
  "ws",
  "ww"
 ],
 "arms": [
  {
   "pre": "ws",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "tp @e[name=talker] 0 -60 3"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies",
    "rock_big",
    "piano_gymnopedie",
    "edm_detection"
   ],
   "play": "spectral:live_demo {song} follow @s 24 \"follow:talker\""
  },
  {
   "pre": "ww",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "tp @e[name=talker] 6 -60 3"
   ],
