{
 "header": [
  "# Spectral Player の測定リグ（本物のクライアントが鳴らした音を録る）: node lab.mjs app run -a spectral --device redroid",
  "#   GitHub では Actions → redroid → Run workflow（addon: spectral, mode: run）。数はジョブのログの `[spectral rig]` の行、録音そのものは",
  "#   `audio export` が Opus にして実行の成果物の public/spectral/rec/ に公開する（鍵なし: 管理パネルでサインインして聞ける・",
  "#   notify.yml が Discord に送る・tools/rig/fetch_rec.py <run> で取る）。",
  "# キュー 04（tools/exp/queue/q04_distance.json）: 3D の距離 3・8・16・32・48 ブロック（6 曲）。スピーカーからの距離ごとの音質と大きさ（届く距離 48 ブロックの中の落ち方）。静かな所が 16 bit の床に沈む距離"
 ],
 "batch": 15,
 "setup": [
  "tp @s 0 -60 0 0 0"
 ],
 "interleave": [
  "d3",
  "d8",
  "d16",
  "d32",
  "d48"
 ],
 "arms": [
  {
   "pre": "d3",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies",
    "rock_big",
    "piano_gymnopedie",
    "edm_detection"
   ],
   "play": "spectral:live_demo {song} near @s 24 \"near:3,-58.5,0,overworld\""
  },
  {
   "pre": "d8",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
