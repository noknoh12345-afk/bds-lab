{
 "header": [
  "# Spectral Player の測定リグ（本物のクライアントが鳴らした音を録る）: node lab.mjs app run -a spectral --device redroid",
  "#   GitHub では Actions → redroid → Run workflow（addon: spectral, mode: run）。数はジョブのログの `[spectral rig]` の行、録音そのものは",
  "#   `audio export` が Opus にして実行の成果物の public/spectral/rec/ に公開する（鍵なし: 管理パネルでサインインして聞ける・",
  "#   notify.yml が Discord に送る・tools/rig/fetch_rec.py <run> で取る）。",
  "# キュー 05（tools/exp/queue/q05_direction.json）: 3D の向き 6 方向（3 曲）。6 ブロック先の東西南北と上下。左右の分かれ方（lr_db）と音質が向きでどう変わるか（前後・上下は今まで測っていない）"
 ],
 "batch": 18,
 "setup": [
  "tp @s 0 -60 0 0 0"
 ],
 "interleave": [
  "oe",
  "ow",
  "os",
  "on",
  "ou",
  "od"
 ],
 "arms": [
  {
   "pre": "oe",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies"
   ],
   "play": "spectral:live_demo {song} near @s 24 \"near:6,-58.5,0,overworld\""
  },
  {
   "pre": "ow",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies"
   ],
   "play": "spectral:live_demo {song} near @s 24 \"near:-6,-58.5,0,overworld\""
  },
  {
   "pre": "os",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies"
   ],
   "play": "spectral:live_demo {song} near @s 24 \"near:0,-58.5,6,overworld\""
  },
  {
   "pre": "on",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "orchestra_five_armies"
   ],
