{
 "header": [
  "# Spectral Player の測定リグ: node lab.mjs app run -a spectral --device redroid（Actions → redroid、addon: spectral, mode: run）。",
  "# p05（tools/exp/queue/p05_limiter.json）: 音割れ止め（/spectral:limit: 混ぜた音のいちばん大きい所を電話の天井 2.0 の下に）を、",
  "# 今の既定（+10 dB、止めなし）・+10 dB で止めあり・+14 dB で止めあり（大きくしても割れないなら上げる）を 13 曲ずつ曲ごとに交互に"
 ],
 "batch": 13,
 "setup": [
  "tp @s 0 -60 0 0 0"
 ],
 "interleave": [
  "e",
  "lm",
  "lm14"
 ],
 "arms": [
  {
   "pre": "e",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:level 10 volume",
    "spectral:limit false"
   ]
  },
  {
   "pre": "lm",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:level 10 volume",
    "spectral:limit true"
   ]
  },
  {
   "pre": "lm14",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:level 14 volume",
    "spectral:limit true"
   ]
  }
 ]
}