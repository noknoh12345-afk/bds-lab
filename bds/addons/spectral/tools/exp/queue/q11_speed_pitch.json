{
 "header": [
  "# Spectral Player の測定リグ（本物のクライアントが鳴らした音を録る）: node lab.mjs app run -a spectral --device redroid",
  "#   GitHub では Actions → redroid → Run workflow（addon: spectral, mode: run）。数はジョブのログの `[spectral rig]` の行、録音そのものは",
  "#   `audio export` が Opus にして実行の成果物の public/spectral/rec/ に公開する（鍵なし: 管理パネルでサインインして聞ける・",
  "#   notify.yml が Discord に送る・tools/rig/fetch_rec.py <run> で取る）。",
  "# キュー 11（tools/exp/queue/q11_speed_pitch.json）: 速さ 0.5・1.5 倍と移調 ±5（4 曲）。/spectral:speed と /spectral:pitch を実機で（一度も測っていない）。あとで元の曲を同じだけ伸ばした・ずらした音と比べる"
 ],
 "batch": 20,
 "setup": [
  "tp @s 0 -60 0 0 0"
 ],
 "interleave": [
  "n1",
  "x05",
  "x15",
  "pu5",
  "pd5"
 ],
 "arms": [
  {
   "pre": "n1",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:speed 1",
    "spectral:pitch 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "piano_gymnopedie",
    "rock_big"
   ],
   "wait": 23000
  },
  {
   "pre": "x05",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:speed 0.5",
    "spectral:pitch 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "piano_gymnopedie",
    "rock_big"
   ],
   "wait": 44000
  },
  {
   "pre": "x15",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:speed 1.5",
    "spectral:pitch 0"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "piano_gymnopedie",
    "rock_big"
   ],
   "wait": 16000
  },
  {
   "pre": "pu5",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:speed 1",
    "spectral:pitch 5"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "piano_gymnopedie",
    "rock_big"
   ],
   "wait": 23000
  },
  {
   "pre": "pd5",
   "pack": "tools/exp/packs/run10",
   "suffix": "_e",
   "conv": {
    "pack": "run10"
   },
   "export": 160,
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:speed 1",
    "spectral:pitch -5"
   ],
   "songs": [
    "speech_ja_soseki",
    "vocal_name_of_love",
    "piano_gymnopedie",
    "rock_big"
   ],
   "wait": 23000
  }
 ]
}