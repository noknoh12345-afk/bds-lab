  {
   "pre": "vt",
   "suffix": "_d",
   "conv": {
    "refine_weights": "svr",
    "refine_sweeps": 5,
    "refine_hold": true
   },
   "pack": "tools/exp/packs/run9",
   "songs": [
    "speech_ja_soseki"
   ],
   "export": 160,
   "play": "spectral:live_demo {song} follow @s 24 \"follow:talker\"",
   "cmds": [
    "tp @s 0 -60 0 0 0",
    "spectral:range 3 10 true",
    "spectral:handover hold",
    "summon armor_stand talker 0 -60 3"
