# bds-lab の設定。このファイルを .env という名前でコピーして、使うものだけ書いてください。
# .env と .env.local は git にもパッチにも入りません。何も書かなくても、アドオンを作って確かめることはできます。

# ---- AI（i18n --ai と maintain が使う。どれか 1 つ）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI 互換のサーバー（ローカル LLM など）とモデル
OPENAI_BASE_URL=
OPENAI_MODEL=
# 使うモデル（空欄ならラボの既定）
LAB_MODEL=
# 小さな仕事（i18n --ai の翻訳）に使うモデル（空欄なら小さく安いもの）
LAB_SMALL_MODEL=

# ---- GitHub（API の回数制限を避けたいときだけ）----
GH_TOKEN=
