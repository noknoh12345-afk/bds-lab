        "gwp_r1": {
          "position": [
            6,
            -11,
            0
          ],
          "scale": [
            "v.gwp_r1 * 0.1",
            "3",
            "1"
          ]
        },
        "gwp_r2": {
          "position": [
            6,
            -16,
            0
          ],
          "scale": [
            "v.gwp_r2 * 0.1",
