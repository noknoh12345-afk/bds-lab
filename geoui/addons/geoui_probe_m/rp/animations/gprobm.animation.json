{
  "format_version": "1.8.0",
  "animations": {
    "animation.gprobm_transform": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "geo_ui": {
          "position": [
            "v.geoui_ox+v.geoui_cx",
            "v.geoui_oy+v.geoui_cy",
            0
          ],
          "scale": "v.geoui_scale*(v.geoui_alpha>0.004?1:0)"
        }
      }
    },
    "animation.gprobm.probe": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "ctl": {
          "scale": "(v.gp_t == 1 || v.gp_t == 99) ? 1 : 0"
        },
        "split": {
          "scale": "(v.gp_t == 2 || v.gp_t == 99) ? (v.gpm_split ?? 0) : 0"
        },
        "split_c": {
          "scale": "(v.gp_t == 3 || v.gp_t == 99) ? (v.gpm_split_c ?? 0) : 0"
        },
        "w1000": {
          "scale": "(v.gp_t == 4 || v.gp_t == 99) ? (v.gpm_w1000 ?? 0) : 0"
        },
        "w1000_c": {
          "scale": "(v.gp_t == 5 || v.gp_t == 99) ? (v.gpm_w1000_c ?? 0) : 0"
        },
        "d24": {
          "scale": "(v.gp_t == 6 || v.gp_t == 99) ? (v.gpm_d24 ?? 0) : 0"
        },
        "d24_c": {
          "scale": "(v.gp_t == 7 || v.gp_t == 99) ? (v.gpm_d24_c ?? 0) : 0"
        },
        "tbl": {
          "scale": "(v.gp_t == 8 || v.gp_t == 99) ? (v.gpm_tbl ?? 0) : 0"
        },
        "tbl_c": {
          "scale": "(v.gp_t == 9 || v.gp_t == 99) ? (v.gpm_tbl_c ?? 0) : 0"
        },
        "lines": {
          "scale": "(v.gp_t == 10 || v.gp_t == 99) ? (v.gpm_lines ?? 0) : 0"
        },
        "lines_c": {
          "scale": "(v.gp_t == 11 || v.gp_t == 99) ? (v.gpm_lines_c ?? 0) : 0"
        }
      }
    }
  }
}