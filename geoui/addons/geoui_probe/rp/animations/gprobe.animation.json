{
  "format_version": "1.8.0",
  "animations": {
    "animation.gprobe_transform": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "geo_ui": {
          "position": [
            "v.geoui_ox+v.geoui_cx",
            "v.geoui_oy+v.geoui_cy",
            0
          ],
          "scale": "v.geoui_scale*(v.geoui_alpha>0.004?1:0)"
        }
      }
    },
    "animation.gprobe.probe": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "ctl": {
          "scale": "(v.gp_t == 1 || v.gp_t == 99) ? 1 : 0"
        },
        "mask1": {
          "scale": "(v.gp_t == 2 || v.gp_t == 99) ? 1 : 0"
        },
        "mask0": {
          "scale": "(v.gp_t == 3 || v.gp_t == 99) ? 1 : 0"
        },
        "maskhalf": {
          "scale": "(v.gp_t == 4 || v.gp_t == 99) ? 1 : 0"
        },
        "cutmask0": {
          "scale": "(v.gp_t == 6 || v.gp_t == 99) ? 1 : 0"
        },
        "cutmaskhalf": {
          "scale": "(v.gp_t == 7 || v.gp_t == 99) ? 1 : 0"
        },
        "texhalf": {
          "scale": "(v.gp_t == 8 || v.gp_t == 99) ? 1 : 0"
        },
        "texhalfcut": {
          "scale": "(v.gp_t == 9 || v.gp_t == 99) ? 1 : 0"
        },
        "masktexhalf": {
          "scale": "(v.gp_t == 10 || v.gp_t == 99) ? 1 : 0"
        },
        "rot90": {
          "rotation": [
            0,
            0,
            90
          ],
          "scale": "(v.gp_t == 11 || v.gp_t == 99) ? 1 : 0"
        },
        "scalemul": {
          "scale": "(v.gp_t == 12 || v.gp_t == 99) ? 1 : 0"
        },
        "posadd": {
          "scale": "(v.gp_t == 13 || v.gp_t == 99) ? 1 : 0"
        },
        "init": {
          "scale": "(v.gp_t == 14 || v.gp_t == 99) ? ((v.gp_init ?? 0) == 7 ? 1 : 0) : 0"
        },
        "atu": {
          "scale": "(v.gp_t == 15 || v.gp_t == 99) ? 1 : 0"
        },
        "atuwrap": {
          "scale": "(v.gp_t == 16 || v.gp_t == 99) ? 1 : 0",
          "position": [
            "(v.gp_t == 16 || v.gp_t == 99) ? 10 : 0",
            0,
            0
          ]
        }
      }
    },
    "animation.gprobe.mul_a": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "scalemul": {
          "scale": 2
        },
        "posadd": {
          "position": [
            10,
            0,
            0
          ]
        }
      }
    },
    "animation.gprobe.mul_b": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "scalemul": {
          "scale": 0.5
        },
        "posadd": {
          "position": [
            10,
            0,
            0
          ]
        }
      }
    },
    "animation.gprobe.atu": {
      "loop": "hold_on_last_frame",
      "animation_length": 1,
      "anim_time_update": "v.gp_u",
      "bones": {
        "atu": {
          "position": {
            "0.0": [
              0,
              0,
              0
            ],
            "1.0": [
              40,
              0,
              0
            ]
          }
        }
      }
    },
    "animation.gprobe.atuwrap": {
      "loop": "hold_on_last_frame",
      "animation_length": 1,
      "anim_time_update": "v.gp_u",
      "bones": {
        "atuwrap_p": {
          "position": {
            "0.0": [
              0,
              0,
              0
            ],
            "1.0": [
              40,
              0,
              0
            ]
          }
        }
      }
    }
  }
}